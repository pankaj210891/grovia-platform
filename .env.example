# ─────────────────────────────────────────────────────────────
# Grovia Platform — Environment Variables
# Copy to .env and fill in your values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/grovia
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-strong-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-a-different-strong-secret-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── Stripe (optional — required when FEATURE_STRIPE_CHECKOUT=true) ─
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email / SMTP (optional — required when FEATURE_EMAIL_NOTIFICATIONS=true) ─
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
EMAIL_FROM=noreply@grovia.com

# ── Tenant ────────────────────────────────────────────────────
DEFAULT_TENANT_ID=default

# ── Branding ──────────────────────────────────────────────────
BRAND_NAME=Grovia
# BRAND_LOGO_URL=https://cdn.example.com/logo.svg
# BRAND_FAVICON_URL=https://cdn.example.com/favicon.ico
BRAND_PRIMARY_COLOR=#2563EB
BRAND_ACCENT_COLOR=#7C3AED
# BRAND_SUPPORT_EMAIL=support@grovia.com
# BRAND_SUPPORT_PHONE=+1-800-000-0000

# ── Locale ────────────────────────────────────────────────────
DEFAULT_LOCALE=en-US
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC

# ── Frontend URLs (NEXT_PUBLIC_ — exposed to browser) ─────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_VENDOR_URL=http://localhost:3003

# ── Feature Flags ─────────────────────────────────────────────
# true | false  (default shown below)
FEATURE_MULTI_VENDOR=false
FEATURE_GUEST_CHECKOUT=true
FEATURE_WISHLIST=true
FEATURE_REVIEWS=true
FEATURE_LOYALTY_POINTS=false
FEATURE_STRIPE_CHECKOUT=false
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_SMS_NOTIFICATIONS=false
FEATURE_DARK_MODE=true
FEATURE_INTERNATIONAL_SHIPPING=false
